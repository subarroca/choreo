# Posa VITE_DEV_MODE=true per treballar sense Supabase.
# Totes les dades es guarden a localStorage del navegador.
VITE_DEV_MODE=true

# Quan tinguis un projecte Supabase real, posa VITE_DEV_MODE=false (o elimina la línia)
# i emplena les credencials:
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
